<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId" access="global">
    <aura:attribute name="recordId" type="Id"/>
    <aura:attribute name="candidate" type="Object"/>
    <force:recordData aura:id="recordLoader" recordId="{!v.recordId}" targetFields="{!v.candidate}" fields="Name,Status__c,Email__c,Skills__c"/>
    <div class="slds-card">
        <div class="slds-card__header">
            <h2 class="slds-text-heading_medium">Candidate Status Card</h2>
        </div>
        <div class="slds-card__body slds-card__body_inner">
            <p><b>Name:</b> {!v.candidate.Name}</p>
            <p><b>Status:</b> {!v.candidate.Status__c}</p>
            <p><b>Email:</b> {!v.candidate.Email__c}</p>
            <p><b>Skills:</b> {!v.candidate.Skills__c}</p>
        </div>
    </div>
</aura:component>