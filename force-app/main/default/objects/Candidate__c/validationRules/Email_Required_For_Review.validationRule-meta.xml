<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Email_Required_For_Review</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;In Review&quot;),
  ISBLANK(email__c)
)</errorConditionFormula>
    <errorDisplayField>email__c</errorDisplayField>
    <errorMessage>Email is required when candidate is In Review</errorMessage>
</ValidationRule>
