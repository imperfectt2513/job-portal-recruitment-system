<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Skills_Required_On_Apply</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Applied&quot;),
  ISBLANK(skills__c)
)</errorConditionFormula>
    <errorDisplayField>skills__c</errorDisplayField>
    <errorMessage>Skills cannot be blank when applying</errorMessage>
</ValidationRule>
